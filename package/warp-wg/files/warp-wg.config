
config warp 'cfg'
	option enabled '0'
	option ifname 'warp0'
	option private_key ''
	option peer_public_key ''
	option address4 ''
	option address6 ''
	option endpoint 'engage.cloudflareclient.com:2408'
	option dns '1.1.1.1'
	option mtu '1280'
	option split_mode 'china'
	option auto_scan '1'
	option watchdog_timeout '180'
	option update_chnroute '1'
	option chnroute_url 'https://raw.githubusercontent.com/misakaio/chnroutes2/master/chnroutes.txt'
	option dns_cn '223.5.5.5'
