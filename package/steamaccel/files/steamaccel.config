config steamaccel 'main'
	option enabled '1'

	# 规则接口。官方原地址，无鉴权，POST {} 即返回全量 JSON。
	option api 'https://api.steampp.net/accelerator/projectgroups'

	# 可选：自建镜像（GET 直取 JSON），官方接口不通时自动退化到它
	option mirror ''

	# 自动更新间隔（小时）。0 = 只在开机时更新一次
	# 每次更新串行做三件事：拉 Watt 规则 -> 同步第三方通道 -> 合并应用
	option update_interval '24'

	# ---- 第三方通道同步 ----
	# 这些老牌工具（UsbEAm / steamcommunity302）各自维护节点，更新比官方勤，
	# 官方规则失效时它们往往还活着。同步来的通道排在 Watt 规则之前生效。
	#
	# usbeam:   dogfight360/UsbEAm 的 usbeam_new_20.xml
	#           [Reverse proxy] 段的 IPLIST 是 4 个通用 SNI 反代 IP
	#           规则条目给的是游戏/CDN 的 443 上游
	option sync_usbeam '1'

	# 302:      steamcommunity302 的 Caddyfile（发布包里是明文）
	#           能读出 str001-003 和 gh*.steam302.xyz 共 14 个上游
	option sync_302 '1'

	# ghproxy:  weekoo2025/ghproxy 的 mirrors.json
	#           这是 URL 前缀镜像（不是 DNS 通道），只给固件自身更新用
	option sync_ghproxy '1'

	# 对写死 IP 的规则做 TCP 探活，连不通的自动退回正常 DNS 解析
	option healthcheck '1'
	option probe_timeout '2000'

	# SNI 分流（需要另装 nginx + stream_ssl_preread 模块）
	# 0 = 只做 DNS 改写；1 = 同时在 443 上按 ClientHello 的 SNI 分流，全链路不解密
	option sni '0'
