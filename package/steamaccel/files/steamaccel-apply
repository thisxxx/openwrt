#!/bin/sh
#
# steamaccel-apply —— 把规则渲染成 dnsmasq 配置并热加载
#
# 流程:
#   rules.json --gen.lua--> 完整 dnsmasq 片段
#                          --probe 探活--> 剔掉连不通的 IP
#                          --> /tmp/dnsmasq.d/steamaccel.conf --> reload dnsmasq
#
# 设计原则: 宁慢不死。某个上游 IP 挂了就退回正常 DNS 解析，绝不写死一条死路。
#
. /lib/functions.sh

RULES_DIR="/etc/steamaccel"
RULES="$RULES_DIR/rules.json"
TMP="/tmp/steamaccel"
OUT="/tmp/dnsmasq.d/steamaccel.conf"
NGX_OUT="/tmp/steamaccel/nginx-upstreams.conf"

log() { logger -t steamaccel "$*"; }

[ "$1" = "--no-healthcheck" ] && HC=0 || HC=1

config_load steamaccel
config_get enabled main enabled 1
config_get use_healthcheck main healthcheck 1
config_get probe_timeout main probe_timeout 2000
config_get sni_enabled main sni 0

[ "$enabled" = "1" ] || {
	rm -f "$OUT"
	/etc/init.d/dnsmasq reload >/dev/null 2>&1
	exit 0
}

[ "$use_healthcheck" = "1" ] || HC=0

mkdir -p "$TMP" /tmp/dnsmasq.d

SRC="$RULES"
[ -s "$SRC" ] || SRC="/usr/share/steamaccel/rules.json"
if [ ! -s "$SRC" ]; then
	log "no rules available"
	exit 1
fi

# ---------- 1. 渲染 ----------
FULL="$TMP/dnsmasq.full"
lua /usr/lib/steamaccel/gen.lua "$SRC" --mode dnsmasq > "$FULL" 2>"$TMP/gen.err"
if [ $? -ne 0 ] || [ ! -s "$FULL" ]; then
	log "gen.lua failed: $(cat "$TMP/gen.err" 2>/dev/null)"
	exit 1
fi

# ---------- 2. 探活：写死 IP 的和 cname 上游都要验 ----------
#
# 关键点：cname 类以前不探活，因为不知道客户端最终会连到哪个 IP。
# 但这类恰恰是"反代挂了但域名还解析得到"的情况——不探活就会写死一条死路。
# 现在先把 forward 域名解析成 IP，和 address 类的 IP 一起探，一个通的就算活。
DEAD="$TMP/dead.txt"
DEAD_DOM="$TMP/dead-domains.txt"
FWD="$TMP/cname-fwd.txt"
: > "$DEAD"
: > "$DEAD_DOM"

sed -n 's|^cname=[^,]*,\(.*\)$|\1|p' "$FULL" | sort -u > "$FWD"

# 汇总所有候选 IP：address 行的 + cname 上游解析出来的
{
	sed -n 's|^address=/[^/]*/\([0-9][0-9.]*\)$|\1|p' "$FULL"
	while IFS= read -r d; do
		[ -n "$d" ] || continue
		resolveip -4 "$d" 2>/dev/null
	done < "$FWD"
} | grep -E '^[0-9]+\.' | sort -u > "$TMP/ips.txt"

if [ "$HC" = "1" ] && command -v steamaccel-probe >/dev/null 2>&1 && [ -s "$TMP/ips.txt" ]; then
	timeout 25 steamaccel-probe -p 443 -t "$probe_timeout" -c 32 -r 2 \
		< "$TMP/ips.txt" 2>/dev/null | awk '$3=="timeout"{print $4}' > "$DEAD"
fi

# 把"所有 IP 都不通"的 cname 上游记下来，落地时整条剔除
if [ -s "$DEAD" ] && [ -s "$FWD" ]; then
	while IFS= read -r d; do
		[ -n "$d" ] || continue
		alive=0
		for ip in $(resolveip -4 "$d" 2>/dev/null); do
			if ! grep -qxF "$ip" "$DEAD"; then alive=1; break; fi
		done
		[ "$alive" = "0" ] && echo "$d" >> "$DEAD_DOM"
	done < "$FWD"
fi

# ---------- 3. 落地 ----------
{
	echo "# steamaccel $(date '+%Y-%m-%d %H:%M:%S')"
	echo "# source: $SRC"
	if [ -s "$DEAD" ]; then
		echo "# $(wc -l < "$DEAD") upstream ip(s) unreachable, fell back to normal DNS"
	fi
	grep -v '^#' "$FULL" | while IFS= read -r line; do
		case "$line" in
		address=*)
			ip=$(echo "$line" | sed -n 's|^address=/[^/]*/\([0-9][0-9.]*\)$|\1|p')
			if [ -n "$ip" ] && [ -s "$DEAD" ] && grep -qxF "$ip" "$DEAD"; then
				continue
			fi
			;;
		cname=*)
			fwd=${line#cname=}
			fwd=${fwd#*,}
			if [ -s "$DEAD_DOM" ] && grep -qxF "$fwd" "$DEAD_DOM"; then
				continue
			fi
			;;
		esac
		echo "$line"
	done
} > "$OUT.tmp"

mv "$OUT.tmp" "$OUT"
chmod 644 "$OUT"

# ---------- 3b. 输出"优先通道"IP 清单，给 warp-wg 做直连白名单 ----------
#
# warp-wg 的分流是"国内直连、其余走隧道"。但公益反代的 IP 在境外，
# 不加这个白名单就会被隧道抢走 —— 变成 客户端→WARP→Akamai 反代→源站 的绕路。
# 有了这份清单，规则通道命中时直连，WARP 只在通道真不通时才接手。
{
	sed -n 's|^address=/[^/]*/\([0-9][0-9.]*\)$|\1|p' "$OUT"
	grep '^cname=' "$OUT" 2>/dev/null | sed 's|^cname=[^,]*,||' | while IFS= read -r d; do
		[ -n "$d" ] && resolveip -4 "$d" 2>/dev/null
	done
} | grep -E '^[0-9]+\.' | sort -u > "$TMP/bypass.txt"

# ---------- 4. SNI 分流（可选，需要 nginx） ----------
if [ "$sni_enabled" = "1" ] && command -v nginx >/dev/null 2>&1; then
	lua /usr/lib/steamaccel/gen.lua "$SRC" --mode nginx > "$NGX_OUT" 2>/dev/null
	if [ -s "$NGX_OUT" ]; then
		cp "$NGX_OUT" /etc/nginx/steamaccel-map.conf 2>/dev/null
		nginx -s reload 2>/dev/null || /etc/init.d/nginx restart >/dev/null 2>&1
		log "nginx sni map applied"
	fi
fi

/etc/init.d/dnsmasq reload >/dev/null 2>&1

# ---------- 3c. 通知分流层刷新"优先通道"清单 ----------
# 规则每天会变，bypass.txt 跟着变，但 nft 的 set 不会自己更新。
# 不刷新的话，新出现的反代 IP 会被隧道的默认规则抢走，白白绕远。
if [ -x /usr/bin/warp-route ] && nft list table inet warp >/dev/null 2>&1; then
	/usr/bin/warp-route fast >/dev/null 2>&1 && log "warp fast set refreshed"
fi

# ---------- 5. 状态，给 LuCI 读 ----------
total=$(grep -c '^\(address\|cname\)=' "$OUT" 2>/dev/null)
ncname=$(grep -c '^cname=' "$OUT" 2>/dev/null)
naddr=$(grep -c '^address=' "$OUT" 2>/dev/null)
ndead=$( [ -s "$DEAD" ] && wc -l < "$DEAD" || echo 0 )
updated=$(cat "$TMP/last_update" 2>/dev/null || echo 0)
[ "$updated" = "0" ] && updated=$(stat -c %Y "$SRC" 2>/dev/null || echo 0)

# 同步来的通道：条数 / 域名数 / 上游数 / 各来源分布
EXTRAS="/etc/steamaccel/extra.tsv"
ex_n=0; ex_dom=0; ex_up=0; ex_ts=0; ex_src=""
if [ -s "$EXTRAS" ]; then
	ex_n=$(wc -l < "$EXTRAS")
	ex_dom=$(cut -f1 "$EXTRAS" | sort -u | wc -l)
	ex_up=$(cut -f2 "$EXTRAS" | sort -u | wc -l)
	ex_ts=$(cat "$TMP/last_sync" 2>/dev/null || stat -c %Y "$EXTRAS" 2>/dev/null || echo 0)
	ex_src=$(cut -f3 "$EXTRAS" | sort -u | tr '\n' ' ')
fi
# 实际生效的同步行数（探活后可能少于总数）
ex_live=$(sed -n '/synced channels/,/end synced channels/p' "$OUT" 2>/dev/null | grep -c '^\(address\|cname\)=' || echo 0)
bypass_n=$( [ -s "$TMP/bypass.txt" ] && wc -l < "$TMP/bypass.txt" || echo 0 )

cat > "$TMP/status.json" <<EOF
{"total":${total:-0},"cname":${ncname:-0},"address":${naddr:-0},"dead":${ndead:-0},"updated":${updated:-0},"source":"$(basename "$SRC")","extra_total":${ex_n:-0},"extra_live":${ex_live:-0},"extra_domains":${ex_dom:-0},"extra_upstreams":${ex_up:-0},"extra_updated":${ex_ts:-0},"extra_sources":"${ex_src}","bypass":${bypass_n:-0}}
EOF

log "applied: total=$total cname=$ncname address=$naddr dead=$ndead synced=$ex_live/$ex_n bypass=$bypass_n"
exit 0
