
config easytier 'main'
	option enabled '0'

	# 网络名与密码：同一网络的所有设备必须一致
	option network_name ''
	option network_secret ''

	# 本机在该虚拟网络里的 IPv4，建议 10.144.144.0/24 段
	option ipv4 '10.144.144.1'

	# 公共中继节点，可加多个（list 可重复）
	list peers 'tcp://public.easytier.cn:11010'
	list peers 'udp://public.easytier.cn:11010'

	# 把本机所在的物理网段通告给整个虚拟网络（可选）
	list subnets ''

	# 私有网络分组，格式 名称#密钥（可选）
	list private_groups ''
