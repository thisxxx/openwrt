#!/bin/sh /etc/rc.common
#
# EasyTier 服务（procd）
#
# 参数与 Padavan 版一致，只是取值从 nvram 换成 UCI：
#   network_name     --network-name    必填
#   ipv4             --ipv4            必填
#   network_secret   --network-secret  可选
#   peers[]          -p                可重复
#   subnets[]        -n                可重复
#   private_groups[] --private-group   可重复
#
# 全部用位置参数拼 argv，不做 eval，值里带 # 空格 引号 都不会出事。
# list 类选项用 config_get 取成空格分隔串再拆词（config_list_foreach 的回调在
# 子 shell 里跑，set -- 影响不到外层，那是坑）。
#
START=90
STOP=10
USE_PROCD=1

set -f   # 关 glob，值里的 * ? [ 不能被当通配符

PROG=/usr/bin/easytier-core

start_service() {
	config_load easytier

	local enabled network_name network_secret ipv4 peers subnets pgrps v
	config_get_bool enabled main enabled 0
	[ "$enabled" = "1" ] || return 0

	config_get network_name main network_name ''
	config_get network_secret main network_secret ''
	config_get ipv4 main ipv4 ''
	config_get peers main peers ''
	config_get subnets main subnets ''
	config_get pgrps main private_groups ''

	[ -n "$network_name" ] || { logger -t easytier "network_name 为空，拒绝启动"; return 1; }
	[ -n "$ipv4" ] || { logger -t easytier "ipv4 为空，拒绝启动"; return 1; }
	[ -x "$PROG" ] || return 1

	set -- "$PROG" --network-name "$network_name" --ipv4 "$ipv4"
	[ -n "$network_secret" ] && set -- "$@" --network-secret "$network_secret"

	for v in $peers;  do [ -n "$v" ] && set -- "$@" -p "$v"; done
	for v in $subnets; do [ -n "$v" ] && set -- "$@" -n "$v"; done
	for v in $pgrps;  do [ -n "$v" ] && set -- "$@" --private-group "$v"; done

	procd_open_instance main
	procd_set_param command "$@"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	logger -t easytier "starting: $network_name / $ipv4"
}

service_triggers() {
	procd_add_reload_trigger easytier
}

reload_service() {
	stop
	start
}
